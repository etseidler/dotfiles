[alias]
	ap = add -p
	ba = branch -a
	bd = branch -d
	ca = commit --amend
	cf = commit --fixup
	cia = commit --amend --no-edit --no-verify
	cl = !sh -c 'git remote prune origin && git branch --all --merged main | grep -viE "main|HEAD" | xargs -r git branch -D'
	cld = !sh -c 'git branch --all --merged main | grep -viE "main|HEAD"'
	cm = commit -m
	cmnv = commit --no-verify -m
	cmf = "cm 'fixup'"
	cmp = !sh -c 'git checkout main && git pull'
	co = checkout
	cob = checkout -b
	cop = checkout -p
	cp = cherry-pick
	cpc = cherry-pick --continue
	dft = difftool
	dc = dft --cached
	l = log --oneline -n 12
	p = push -u origin HEAD
	pf = p -f
	rc = rebase --continue
	rp = remote prune origin
	rpd = remote prune --dry-run origin
	predev = !sh -c 'git checkout dev && git pull && git checkout - && git rebase dev'
	preman = !sh -c 'git checkout main && git pull && git checkout - && git rebase main'
	redev = rebase dev
	redeiv = rebase -i dev
	reman = rebase main
	remain = rebase -i main
	remotes = remote -v
	ri = rebase -i
	ro = !sh -c 'git rebase --onto $1 $2 $(git rev-parse --abbrev-ref HEAD)' -
	sl = stash list
	sp = stash pop
	# ss = stash
	ss = rev-parse --short=6 HEAD
	st = status -sb
	tags = tag -l
[diff]
	tool = difftastic
	wsErrorHighlight = all
[difftool]
        prompt = false
[difftool "difftastic"]
        cmd = difft "$LOCAL" "$REMOTE"
[init]
	defaultBranch = main
[pager]
	difftool = true
[pull]
	rebase = true
[push]
	autoSetupRemote = true
[rebase]
	autostash = true
[user]
	name =
	email =
[fetch]
	prune = true
[ghq]
	root = ~/Developer
	vcs  = git
